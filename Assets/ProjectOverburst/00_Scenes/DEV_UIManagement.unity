    - target: {fileID: 4330497942010077766, guid: dda84141e0c97f0498c16c02f17744fa, type: 3}
      propertyPath: m_Text
      value: "\uC57C\uC678 \uC0AC\uB0E5\uD130\uC5D0\uC11C \uBAAC\uC2A4\uD130 \uC5F4
        \uB9C8\uB9AC\uB97C \uCC98\uCE58\uD558\uC138\uC694. \uBAA9\uD45C\uB97C \uB2EC\uC131\uD55C
        \uB4A4 \uBA54\uC778 \uB9C8\uC744\uC758 \uBB34\uAE30\uC0C1\uC778\uC5D0\uAC8C
        \uB3CC\uC544\uAC00 \uBCF4\uACE0\uD558\uBA74 \uC57D\uC18D\uD55C \uBCF4\uC0C1\uC744
        \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
