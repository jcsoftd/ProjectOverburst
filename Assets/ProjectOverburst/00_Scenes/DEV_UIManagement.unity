    - target: {fileID: 4688655565561514877, guid: dda84141e0c97f0498c16c02f17744fa, type: 3}
      propertyPath: m_Text
      value: "\uB9C8\uC744 \uBC16 \uAE38\uBAA9\uC5D0 \uBAAC\uC2A4\uD130\uAC00 \uB098\uD0C0\uB098
        \uC0C1\uB2E8\uC758 \uC655\uB798\uAC00 \uB04A\uAE30\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
        \uBB34\uAE30\uC0C1\uC778\uC740 \uC8FC\uBCC0\uC744 \uC815\uB9AC\uD560 \uBAA8\uD5D8\uAC00\uB97C
        \uCC3E\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uB9C8\uC744\uC744 \uC624\uAC00\uB294
        \uAE38\uC744 \uB2E4\uC2DC \uC5F4\uAE30 \uC704\uD55C \uCCAB \uC758\uB8B0\uC785\uB2C8\uB2E4."
      objectReference: {fileID: 0}
