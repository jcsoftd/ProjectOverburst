    - target: {fileID: 771944050473899440, guid: dda84141e0c97f0498c16c02f17744fa, type: 3}
      propertyPath: m_Text
      value: "\uB9C8\uC744 \uBC16 \uAE38\uBAA9\uC5D0 \uBAAC\uC2A4\uD130\uAC00 \uB098\uD0C0\uB098
        \uC0C1\uB2E8\uC758 \uC655\uB798\uAC00 \uB04A\uAE30\uACE0 \uC788\uB124. \uB9C8\uC744\uC744
        \uC624\uAC00\uB294 \uAE38\uBD80\uD130 \uC815\uB9AC\uD574\uC57C\uACA0\uC5B4.
        \uC790\uB124\uAC00 \uC774 \uC77C\uC744 \uB9E1\uC544\uC904 \uC218 \uC788\uACA0\uB098?"
      objectReference: {fileID: 0}
