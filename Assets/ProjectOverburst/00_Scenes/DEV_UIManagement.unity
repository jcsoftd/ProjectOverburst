    - target: {fileID: 915136717909636978, guid: dda84141e0c97f0498c16c02f17744fa, type: 3}
      propertyPath: m_Text
      value: "\uCCAB \uC0AC\uB0E5\uC758 \uBAA9\uD45C\uB97C \uB2EC\uC131\uD588\uC2B5\uB2C8\uB2E4.\n\uBB34\uAE30\uC0C1\uC778\uC5D0\uAC8C
        \uBCF4\uACE0\uD558\uACE0 \uBCF4\uC0C1\uC744 \uBC1B\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
