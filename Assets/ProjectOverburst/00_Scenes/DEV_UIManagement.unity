      propertyPath: m_Text
      value: "\uCCAB \uC0AC\uB0E5\uC758 \uBAA9\uD45C\uB97C \uB2EC\uC131\uD588\uC2B5\uB2C8\uB2E4.\n\uBB34\uAE30\uC0C1\uC778\uC5D0\uAC8C
