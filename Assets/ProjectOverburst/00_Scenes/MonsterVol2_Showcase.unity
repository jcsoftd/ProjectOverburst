      scale: 0.60965466
      actor: {fileID: 639294522}
    - catalogIndex: 26
      tier: 2
      scale: 0.7321123
      actor: {fileID: 1518791295}
  - title: "\uC2EC\uC5F0\xB7\uC870\uAC04\uB300 \uD3EC\uC2DD\uAD70"
    reason: "\uC5B4\uB958\xB7\uAC00\uC624\uB9AC\xB7\uB450\uC871\uB958\uC640 \uAE34
      \uBAA9\uC758 \uC815\uC608. \uC218\uBCC0\uC774\uB098 \uCE68\uC218 \uAD6C\uC5ED\uC5D0
      \uC5B4\uC6B8\uB9AC\uB294 \uC2E4\uB8E8\uC5E3."
    caution: "\uC870\uAC74\uBD80 \uD6C4\uBCF4. \uC218\uC601\xB7\uBE44\uD589 \uD074\uB9BD\uC774
      \uC11E\uC5EC \uC788\uC5B4 \uC77C\uBC18 \uC9C0\uC0C1 \uAD70\uC9D1\uC5D0 \uBC14\uB85C
      \uD22C\uC785\uD558\uC9C0 \uC54A\uC74C."
    root: {fileID: 1107023314}
    members:
    - catalogIndex: 24
      tier: 0
