  catalogFloor: {fileID: 2016681215}
  sets:
  - title: "\uAC70\uBBF8 \uBD80\uD654 \uAD70\uB77D"
    reason: "\uB465\uADFC \uC720\uCDA9 \u2192 \uAC00\uC2DC \uAC70\uBBF8 \u2192 \uAC70\uB300
      \uBAA8\uCCB4. \uAC00\uC7A5 \uC790\uC5F0\uC2A4\uB7EC\uC6B4 \uC131\uC7A5 \uACC4\uC5F4."
    caution: "1\uC21C\uC704 \uCD94\uCC9C. Carcinoptera\uB294 \uC9C0\uC0C1 \uD074\uB9BD
      \uAE30\uC900. \uC54C #30\uC740 \uC804\uD22C\uC6D0 \uB300\uC2E0 \uBD80\uD654
      \uC7A5\uCE58 \uD6C4\uBCF4."
    root: {fileID: 1560466408}
    members:
    - catalogIndex: 30
      tier: 0
      scale: 1.3373941
      actor: {fileID: 1788149779}
    - catalogIndex: 16
      tier: 0
      scale: 0.5987965
      actor: {fileID: 1547800000}
    - catalogIndex: 33
      tier: 1
      scale: 0.9938036
      actor: {fileID: 2038665399}
    - catalogIndex: 2
      tier: 1
      scale: 0.7015315
      actor: {fileID: 200947803}
    - catalogIndex: 28
      tier: 2
      scale: 0.34554857
      actor: {fileID: 817892316}
  - title: "\uB3C5\uB0AD \uC678\uACE8\uACA9 \uAD70\uB77D"
    reason: "\uC8FC\uD669\uC0C9 \uB3C5\uB0AD\uACFC \uB9C8\uB978 \uB2E4\uB9AC \uC2E4\uB8E8\uC5E3
      \uD1B5\uC77C. Kupolojuve\uC640 Kupolobrach\uB294 \uC720\uCCB4\xB7\uC131\uCCB4
      \uC870\uD569."
    caution: "1\uC21C\uC704 \uCD94\uCC9C. \uB3C5\xB7\uD22C\uC0AC\uCCB4 \uC5ED\uD560\uC740
      \uC678\uD615/\uD074\uB9BD \uAE30\uBC18 \uC81C\uC548\uC774\uBA70 \uC2E4\uC81C
      \uACF5\uACA9 \uB370\uC774\uD130\uB294 \uBBF8\uC5F0\uACB0."
    root: {fileID: 995296307}
    members:
    - catalogIndex: 37
      tier: 0
      scale: 0.7452413
      actor: {fileID: 295149099}
    - catalogIndex: 39
      tier: 0
      scale: 0.7452413
      actor: {fileID: 1147382004}
    - catalogIndex: 0
      tier: 1
      scale: 0.92211
      actor: {fileID: 1036003180}
    - catalogIndex: 23
      tier: 1
      scale: 0.94784164
      actor: {fileID: 1826780519}
    - catalogIndex: 20
      tier: 2
      scale: 0.29268885
      actor: {fileID: 147721082}
  - title: "\uAC00\uC2DC\uAC11\uC8FC \uB3CC\uACA9\uB300"
    reason: "\uD68C\uC0C9 \uAC11\uD53C\uC640 \uB4F1 \uAC00\uC2DC \uC911\uC2EC. Crustaspikan
      \uC720\uCDA9\uC5D0\uC11C \uC131\uCCB4 \uC815\uC608\uB85C \uC774\uC5B4\uC9C0\uB294
      \uBB34\uAC70\uC6B4 \uC9D1\uB2E8."
    caution: "Crustaspikan\uC740 \uD070 \uD3ED\uC73C\uB85C \uCD95\uC18C\uD55C \uC81C\uC548.
      \uACF5\uACA9 \uBC94\uC704\xB7\uD68C\uC804 \uBC18\uACBD\uC740 \uBCC4\uB3C4 \uC81C\uC791
      \uB54C \uC870\uC815."
    root: {fileID: 1629833485}
    members:
    - catalogIndex: 6
      tier: 0
      scale: 0.38418546
      actor: {fileID: 1669313482}
    - catalogIndex: 7
      tier: 1
      scale: 0.8926
      actor: {fileID: 2021958942}
    - catalogIndex: 43
      tier: 1
      scale: 0.60965466
      actor: {fileID: 522148993}
    - catalogIndex: 5
      tier: 2
      scale: 0.3203378
      actor: {fileID: 291488934}
  - title: "\uD3EC\uC790\xB7\uBD80\uD328 \uACF5\uC0DD\uAD70"
    reason: "\uBC84\uC12F\xB7\uBD80\uD47C \uC5F0\uC870\uC9C1\xB7\uCD09\uC218 \uC5BC\uAD74\uC758
      \uACF5\uC0DD \uC9D1\uB2E8. \uCC3D\uBC31\uD558\uACE0 \uB179\uC0C9\uC778 \uC721\uC9C8\uC744
      \uAE30\uC900\uC73C\uB85C \uBB36\uC74C."
    caution: "\uC870\uAC74\uBD80 \uD6C4\uBCF4. \uC18C\uD615 \uB458\uC740 \uBD80\uC720
      \uACC4\uC5F4\uC774\uBBC0\uB85C \uC800\uACF5 \uC774\uB3D9\uACFC \uC9C0\uC0C1
      \uD53C\uACA9 \uB192\uC774 \uC124\uACC4\uAC00 \uD544\uC694."
    root: {fileID: 1561574936}
    members:
    - catalogIndex: 10
      tier: 0
      scale: 1.4809377
      actor: {fileID: 1512265728}
    - catalogIndex: 14
      tier: 0
      scale: 0.60333586
      actor: {fileID: 1297150626}
    - catalogIndex: 3
      tier: 1
      scale: 1.4167049
      actor: {fileID: 87856073}
    - catalogIndex: 25
      tier: 1
      scale: 0.42421713
      actor: {fileID: 248724499}
    - catalogIndex: 4
      tier: 2
      scale: 0.6718705
      actor: {fileID: 423803026}
  - title: "\uC6D0\uC2DC \uD3EC\uC2DD\uC790 \uBB34\uB9AC"
    reason: "\uC0AC\uB0E5\uAC1C\uD615 \uC120\uBD09, \uC9C1\uB9BD \uD30C\uCDA9\uB958,
      \uC721\uC911\uD55C \uC0AC\uC871 \uD3EC\uC2DD\uC790. \uC9C0\uC0C1 \uCD94\uACA9
      \uC911\uC2EC\uC73C\uB85C \uC4F0\uAE30 \uC26C\uC6B4 \uC870\uD569."
    caution: "1\uC21C\uC704 \uCD94\uCC9C. \uC11C\uB85C \uB2E4\uB978 \uC885\uC758
      \uC0AC\uB0E5 \uBB34\uB9AC \uD14C\uB9C8. \uAC19\uC740 \uC885\uC758 \uC131\uC7A5
      \uACC4\uBCF4\uB97C \uC758\uBBF8\uD558\uC9C0 \uC54A\uC74C."
    root: {fileID: 10360374}
    members:
    - catalogIndex: 1
      tier: 0
      scale: 0.9295939
      actor: {fileID: 607120795}
    - catalogIndex: 7
      tier: 1
      scale: 0.8926
      actor: {fileID: 2015998904}
    - catalogIndex: 41
