  m_Script: {fileID: 11500000, guid: c636e5c9124ab0b4380608e198dfd4c8, type: 3}
  m_Name: FirstHunt
  m_EditorClassIdentifier: Assembly-CSharp::Overburst.Quests.QuestDefinition
  id: quest.main-town.weapon.first-hunt
  version: 1
  giverMerchantId: merchant.main-town.weapon
  turnInMerchantId: merchant.main-town.weapon
  prerequisiteId: 
  minimumLevel: 1
  sortOrder: 0
  title: "\uCCAB \uC0AC\uB0E5"
  description: "\uB9C8\uC744 \uBC16 \uAE38\uBAA9\uC5D0 \uBAAC\uC2A4\uD130\uAC00 \uB098\uD0C0\uB098
    \uC0C1\uB2E8\uC758 \uC655\uB798\uAC00 \uB04A\uAE30\uACE0 \uC788\uB124. \uB9C8\uC744\uC744
    \uC624\uAC00\uB294 \uAE38\uBD80\uD130 \uC815\uB9AC\uD574\uC57C\uACA0\uC5B4. \uC790\uB124\uAC00
    \uC774 \uC77C\uC744 \uB9E1\uC544\uC904 \uC218 \uC788\uACA0\uB098?\n\n\uC57C\uC678
    \uC0AC\uB0E5\uD130\uC5D0\uC11C \uBAAC\uC2A4\uD130 \uC5F4 \uB9C8\uB9AC\uB97C \uCC98\uCE58\uD558\uACE0
    \uB3CC\uC544\uC624\uAC8C. \uBAA9\uD45C\uB97C \uB2EC\uC131\uD55C \uB4A4 \uC774
    \uB300\uC7A5\uAC04\uC5D0\uC11C \uBCF4\uACE0\uD558\uAC8C. \uC790\uB124\uAC00 \uC218\uACE0\uD55C
    \uB9CC\uD07C \uC57D\uC18D\uD55C \uBCF4\uC0C1\uC744 \uC900\uBE44\uD574 \uB450\uACA0\uB124."
  journalDescription: "\uB9C8\uC744 \uBC16 \uAE38\uBAA9\uC5D0 \uBAAC\uC2A4\uD130\uAC00
    \uB098\uD0C0\uB098 \uC0C1\uB2E8\uC758 \uC655\uB798\uAC00 \uB04A\uAE30\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
    \uBB34\uAE30\uC0C1\uC778\uC740 \uC8FC\uBCC0\uC744 \uC815\uB9AC\uD560 \uBAA8\uD5D8\uAC00\uB97C
    \uCC3E\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uB9C8\uC744\uC744 \uC624\uAC00\uB294
    \uAE38\uC744 \uB2E4\uC2DC \uC5F4\uAE30 \uC704\uD55C \uCCAB \uC758\uB8B0\uC785\uB2C8\uB2E4.\n\n\uC57C\uC678
    \uC0AC\uB0E5\uD130\uC5D0\uC11C \uBAAC\uC2A4\uD130 \uC5F4 \uB9C8\uB9AC\uB97C \uCC98\uCE58\uD558\uC138\uC694.
    \uBAA9\uD45C\uB97C \uB2EC\uC131\uD55C \uB4A4 \uBA54\uC778 \uB9C8\uC744\uC758
    \uBB34\uAE30\uC0C1\uC778\uC5D0\uAC8C \uB3CC\uC544\uAC00 \uBCF4\uACE0\uD558\uBA74
    \uC57D\uC18D\uD55C \uBCF4\uC0C1\uC744 \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  readyDescription: "\uB3CC\uC544\uC654\uAD70. \uAE38\uBAA9\uC744 \uC815\uB9AC\uD574\uC918\uC11C
    \uACE0\uB9D9\uB124. \uBAAC\uC2A4\uD130 \uC5F4 \uB9C8\uB9AC\uB97C \uBAA8\uB450
    \uCC98\uCE58\uD55C \uAC83\uC744 \uD655\uC778\uD588\uB124.\n\n\uC790\uB124\uAC00
    \uC218\uACE0\uD55C \uB9CC\uD07C \uC57D\uC18D\uD55C \uBCF4\uC0C1\uC744 \uC900\uBE44\uD574
    \uB450\uC5C8\uB124. \uC758\uB8B0\uB97C \uBCF4\uACE0\uD558\uACE0 \uBC1B\uC544\uAC00\uAC8C.
    \uB2E4\uC74C \uBAA8\uD5D8\uC744 \uC900\uBE44\uD558\uB294 \uB370 \uB3C4\uC6C0\uC774
    \uB420 \uAC78\uC138."
  completedDescription: "\uC798 \uD574\uB0C8\uB124. \uC790\uB124 \uB355\uC5D0 \uB9C8\uC744
    \uBC16 \uAE38\uC774 \uD55C\uACB0 \uC548\uC804\uD574\uC84C\uC5B4. \uC0C1\uB2E8\uB3C4
    \uB2E4\uC2DC \uC774 \uAE38\uC744 \uC774\uC6A9\uD560 \uC218 \uC788\uACA0\uAD70.\n\n\uC57D\uC18D\uD55C
    \uBCF4\uC0C1\uC740 \uBAA8\uB450 \uAC74\uB124\uC8FC\uC5C8\uB124. \uB2E4\uC74C\uC5D0\uB294
    \uC9C0\uB3C4\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30\uD574\uBCF4\uC138. \uC57C\uC678\uC5D0\uC11C
    \uBC1C\uACAC\uD55C \uC9C0\uB3C4\uB85C \uC0C8\uB85C\uC6B4 \uC0AC\uB0E5\uD130\uB97C
    \uCC3E\uC744 \uC218 \uC788\uC744 \uAC78\uC138."
  objectives:
  - kind: 0
    targetId: enemy.any-run
    label: "\uC57C\uC678 \uBAAC\uC2A4\uD130 \uCC98\uCE58"
    required: 10
