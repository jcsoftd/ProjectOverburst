  m_Script: {fileID: 11500000, guid: c636e5c9124ab0b4380608e198dfd4c8, type: 3}
  m_Name: FirstMap
  m_EditorClassIdentifier: Assembly-CSharp::Overburst.Quests.QuestDefinition
  id: quest.main-town.weapon.first-map
  version: 1
  giverMerchantId: merchant.main-town.weapon
  turnInMerchantId: merchant.main-town.weapon
  prerequisiteId: quest.main-town.weapon.first-hunt
  minimumLevel: 1
  sortOrder: 1
  title: "\uBBF8\uC9C0\uC758 \uC9C0\uB3C4"
  description: "\uC57C\uC678\uC5D0\uC11C \uC9C0\uB3C4\uB97C \uCC3E\uAC70\uB4E0 \uB9C8\uC744\uC758
    \uB358\uC804 \uD3EC\uD0C8\uC5D0 \uB123\uC5B4\uBCF4\uAC8C. \uC9C0\uB3C4\uC5D0
    \uC0C8\uACA8\uC9C4 \uC7A5\uC18C\uB85C \uAC00\uB294 \uAE38\uC774 \uC5F4\uB9B4
    \uAC78\uC138.\n\n\uC9C0\uB3C4\uB9C8\uB2E4 \uD5A5\uD558\uB294 \uC0AC\uB0E5\uD130\uAC00
    \uB2E4\uB974\uB124. \uD3EC\uD0C8\uC5D0\uC11C \uC9C0\uB3C4\uC758 \uC815\uBCF4\uB97C
    \uC0B4\uD3B4\uBCF4\uACE0 \uC785\uC7A5\uD558\uAC8C. \uAE38\uC744 \uC5F4 \uB54C\uC5D0\uB294
    \uC120\uD0DD\uD55C \uC9C0\uB3C4 \uD55C \uC7A5\uC774 \uD544\uC694\uD558\uB124."
  journalDescription: "\uC57C\uC678 \uC0AC\uB0E5\uD130\uC5D0\uC11C \uBC1C\uACAC\uD55C
    \uC9C0\uB3C4\uC5D0\uB294 \uC544\uC9C1 \uAC00\uBCF4\uC9C0 \uBABB\uD55C \uC7A5\uC18C\uAC00
    \uB2F4\uACA8 \uC788\uC2B5\uB2C8\uB2E4. \uBA54\uC778 \uB9C8\uC744\uC758 \uB358\uC804
    \uD3EC\uD0C8\uC5D0\uC11C \uC9C0\uB3C4\uB97C \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uD3EC\uD0C8\uC5D0
    \uC9C0\uB3C4\uB97C \uB123\uACE0 \uC0AC\uB0E5\uD130 \uC815\uBCF4\uB97C \uD655\uC778\uD558\uC138\uC694.
    \uC785\uC7A5\uD558\uBA74 \uC120\uD0DD\uD55C \uC9C0\uB3C4 \uD55C \uC7A5\uC744
    \uC18C\uBAA8\uD558\uBA70, \uC0C8\uB85C\uC6B4 \uB358\uC804\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."
  readyDescription: "\uC9C0\uB3C4\uC5D0 \uC0C8\uACA8\uC9C4 \uC7A5\uC18C\uAE4C\uC9C0
    \uB2E4\uB140\uC654\uAD70. \uC0C8\uB85C\uC6B4 \uAE38\uC744 \uC9C1\uC811 \uD655\uC778\uD55C
    \uBAA8\uD5D8\uAC00\uB294 \uD754\uD558\uC9C0 \uC54A\uB124.\n\n\uC57D\uC18D\uD55C
    \uBCF4\uC0C1\uC744 \uC900\uBE44\uD574 \uB450\uC5C8\uB124. \uB2E4\uC74C \uBAA8\uD5D8\uC744
    \uC704\uD55C \uC7A5\uBE44\uB97C \uC810\uAC80\uD558\uACE0 \uAC00\uAC8C."
  completedDescription: "\uC9C0\uB3C4\uB97C \uB530\uB77C \uC0C8\uB85C\uC6B4 \uC0AC\uB0E5\uD130\uAE4C\uC9C0
    \uD655\uC778\uD588\uAD70. \uC55E\uC73C\uB85C\uB3C4 \uBC1C\uACAC\uD55C \uC9C0\uB3C4\uB294
    \uD3EC\uD0C8\uC5D0\uC11C \uC0B4\uD3B4\uBCF4\uAC8C.\n\n\uC57D\uC18D\uD55C \uBCF4\uC0C1\uC740
    \uBAA8\uB450 \uAC74\uB124\uC8FC\uC5C8\uB124. \uB2E4\uC74C \uBAA8\uD5D8\uC5D0\uC11C\uB3C4
    \uBB34\uC0AC\uD788 \uB3CC\uC544\uC624\uAC8C."
  objectives:
  - kind: 3
    targetId: map.any
    label: "\uC9C0\uB3C4 \uD68D\uB4DD"
    required: 1
  - kind: 4
    targetId: portal.map
    label: "\uB358\uC804 \uD3EC\uD0C8\uC5D0 \uC9C0\uB3C4 \uB123\uAE30"
    required: 1
  - kind: 2
    targetId: run.map
    label: "\uC9C0\uB3C4 \uB358\uC804\uC73C\uB85C \uC785\uC7A5"
    required: 1
  rewardGold: 150
  rewardExperience: 40
  rewardReputation: 10
